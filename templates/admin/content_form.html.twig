{% extends 'admin/base.html.twig' %}

{% block admin_title %}{{ isNew ? 'Ajouter' : 'Modifier' }} — {{ config.singular }}{% endblock %}

{% block admin_content %}
<div class="mb-6">
    <a href="{{ path('admin_' ~ resource) }}" class="text-sm text-pasteur-dark hover:underline">&larr; Retour à {{ config.label|lower }}</a>
    <h2 class="mt-3 text-xl font-semibold text-slate-800">{{ isNew ? 'Nouveau' : 'Modifier le' }} {{ config.singular }}</h2>
</div>

{{ form_start(form, {'attr': {'class': 'bp-card space-y-5 p-6'}}) }}
    {% for field in form %}
        {% set isChoice = 'choice' in field.vars.block_prefixes %}
        {% set isCheckbox = 'checkbox' in field.vars.block_prefixes %}
        <div>
            {{ form_label(field, null, {'label_attr': {'class': 'bp-label'}}) }}
            {% if isCheckbox %}
                {{ form_widget(field, {'attr': {'class': 'h-4 w-4 rounded border-slate-300 text-pasteur-green'}}) }}
            {% elseif isChoice %}
                {{ form_widget(field, {'attr': {'class': 'bp-input'}}) }}
            {% else %}
                {{ form_widget(field, {'attr': {'class': 'bp-input'}}) }}
            {% endif %}
            {{ form_errors(field) }}
        </div>
    {% endfor %}
    {{ form_rest(form) }}
    <div class="flex flex-wrap gap-3 border-t border-slate-100 pt-5">
        <button type="submit" class="bp-btn-primary">Enregistrer</button>
        <a href="{{ path('admin_' ~ resource) }}" class="bp-btn-outline">Annuler</a>
    </div>
{{ form_end(form) }}
{% endblock %}
