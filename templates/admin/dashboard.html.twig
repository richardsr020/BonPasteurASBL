{% extends 'admin/base.html.twig' %}

{% block admin_title %}Tableau de bord{% endblock %}

{% block admin_content %}
<div class="mb-6">
    <h2 class="text-xl font-semibold text-slate-800">Bienvenue, {{ app.user.fullName }}</h2>
    <p class="mt-1 text-sm text-slate-500">Vue d'ensemble du site institutionnel et des archives numériques.</p>
</div>

<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
    {% for label, value in stats %}
        <div class="bp-card p-5">
            <p class="text-sm text-slate-500">{{ label|replace({'_': ' '})|capitalize }}</p>
            <p class="mt-2 text-3xl font-bold text-pasteur-dark">{{ value }}</p>
        </div>
    {% endfor %}
</div>

<div class="mt-8 grid gap-6 lg:grid-cols-2">
    <section class="bp-card p-6">
        <h3 class="font-semibold text-slate-800">Accès rapides</h3>
        <div class="mt-4 flex flex-wrap gap-3">
            <a href="{{ path('admin_ged_years') }}" class="bp-btn-primary">Explorer les archives</a>
            <a href="{{ path('admin_articles') }}" class="bp-btn-outline">Publier une actualité</a>
            <a href="{{ path('admin_messages') }}" class="bp-btn-outline">Messages reçus</a>
        </div>
    </section>
    <section class="bp-card p-6">
        <h3 class="font-semibold text-slate-800">État du système</h3>
        <p class="mt-3 text-sm text-slate-600">Stockage privé hors web · Sauvegardes nocturnes à 02h00 · Accès contrôlé par rôles.</p>
    </section>
</div>
{% endblock %}
