{% extends 'admin/base.html.twig' %}

{% block admin_title %}Message reçu{% endblock %}

{% block admin_content %}
<div class="mb-6">
    <a href="{{ path('admin_messages') }}" class="text-sm text-pasteur-dark hover:underline">&larr; Retour aux messages</a>
</div>

<div class="bp-card p-6">
    <h2 class="text-xl font-semibold text-slate-800">{{ message.subject ?: '(sans sujet)' }}</h2>
    <p class="mt-2 text-sm text-slate-500">De {{ message.senderName }} &lt;{{ message.senderEmail }}&gt; · {{ message.createdAt|date('d/m/Y H:i') }}</p>
    <div class="mt-6 whitespace-pre-line border-t border-slate-100 pt-5 text-sm leading-relaxed text-slate-700">{{ message.message }}</div>
    <form method="post" action="{{ path('admin_messages_delete', {id: message.id}) }}" class="mt-6" data-controller="confirm" data-confirm-message-value="Supprimer ce message ?">
        <input type="hidden" name="_token" value="{{ csrf_token('delete_message' ~ message.id) }}">
        <button type="submit" class="bp-btn border border-red-200 px-4 py-2 text-sm text-red-600" data-action="confirm#submit">Supprimer</button>
    </form>
</div>
{% endblock %}
