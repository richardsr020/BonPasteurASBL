{% extends 'public/base.html.twig' %}

{% block title %}Actualités — ASBL Bon Pasteur RDC{% endblock %}

{% block public_content %}
<div class="bg-pasteur-dark py-14 text-white">
    <div class="mx-auto max-w-7xl px-4">
        <h1 class="text-3xl font-bold md:text-4xl">Actualités et activités</h1>
        <p class="mt-3 max-w-3xl text-white/75">Publications institutionnelles, activités de terrain et communiqués.</p>
    </div>
</div>

<div class="mx-auto max-w-7xl px-4 py-10">
    <div class="mb-8 flex flex-wrap gap-2">
        <a href="{{ path('app_articles', {_locale: app.request.locale}) }}" class="bp-btn px-3 py-1.5 text-xs {% if not currentCategory %}bg-pasteur-green text-white{% else %}border border-slate-300 bg-white text-slate-600{% endif %}">Toutes</a>
        {% for category in categories %}
            <a href="{{ path('app_articles', {_locale: app.request.locale, category: category.value}) }}" class="bp-btn px-3 py-1.5 text-xs {% if currentCategory == category.value %}bg-pasteur-green text-white{% else %}border border-slate-300 bg-white text-slate-600{% endif %}">{{ category.label() }}</a>
        {% endfor %}
    </div>

    <div class="grid gap-6 md:grid-cols-3">
        {% for article in articles %}
            <article class="bp-card overflow-hidden">
                {% if article.coverImage %}<img src="{{ article.coverImage starts with '/' ? article.coverImage : asset('uploads/' ~ article.coverImage) }}" alt="{{ article.title|translate_content(app.request.locale) }}" class="h-44 w-full object-cover" loading="lazy">{% endif %}
                <div class="p-6">
                    <span class="bp-badge bg-slate-100 text-slate-600">{{ article.category.label() }}</span>
                    <h2 class="mt-3 text-lg font-semibold text-slate-800">{{ article.title|translate_content(app.request.locale) }}</h2>
                    <p class="mt-1 text-xs text-slate-500">{{ article.publishedAt ? article.publishedAt|date('d/m/Y') : '' }}</p>
                    <p class="mt-3 line-clamp-4 text-sm text-slate-600">{{ (article.content|striptags)|translate_content(app.request.locale) }}</p>
                    <a href="{{ path('app_article_show', {_locale: app.request.locale, slug: article.slug}) }}" class="mt-4 inline-block text-sm font-semibold text-pasteur-dark hover:underline">{{ 'actions.read_more'|trans }} &rarr;</a>
                </div>
            </article>
        {% else %}
            <p class="text-sm text-slate-500">Aucun article publié.</p>
        {% endfor %}
    </div>
    {{ include('public/_pagination.html.twig') }}
</div>
{% endblock %}
