{% extends 'public/base.html.twig' %}

{% block title %}Qui sommes-nous ? — ASBL Bon Pasteur RDC{% endblock %}

{% block public_content %}
<div class="bg-pasteur-dark py-14 text-white">
    <div class="mx-auto max-w-7xl px-4">
        <h1 class="text-3xl font-bold md:text-4xl">Qui sommes-nous ?</h1>
        <p class="mt-3 max-w-3xl text-white/75">{{ (settings.shortDescription ?? '')|translate_content(app.request.locale) }}</p>
    </div>
</div>

<div class="mx-auto max-w-7xl space-y-14 px-4 py-14">
    <section class="grid gap-10 lg:grid-cols-2">
        <div>
            <h2 class="bp-section-title">Notre histoire</h2>
            <p class="mt-4 leading-relaxed text-slate-600">{{ (settings.history ?? '')|translate_content(app.request.locale) }}</p>
        </div>
        <div>
            <h2 class="bp-section-title">Objectifs institutionnels</h2>
            <p class="mt-4 leading-relaxed text-slate-600">{{ (settings.objectives ?? '')|translate_content(app.request.locale) }}</p>
        </div>
    </section>

    <section class="grid gap-6 md:grid-cols-3">
        <div class="bp-card p-6"><h3 class="font-semibold text-pasteur-dark">Mission</h3><p class="mt-3 text-sm leading-relaxed text-slate-600">{{ (settings.mission ?? '')|translate_content(app.request.locale) }}</p></div>
        <div class="bp-card p-6"><h3 class="font-semibold text-pasteur-dark">Vision</h3><p class="mt-3 text-sm leading-relaxed text-slate-600">{{ (settings.vision ?? '')|translate_content(app.request.locale) }}</p></div>
        <div class="bp-card p-6"><h3 class="font-semibold text-pasteur-dark">Valeurs</h3><p class="mt-3 whitespace-pre-line text-sm leading-relaxed text-slate-600">{{ (settings.values ?? '')|translate_content(app.request.locale) }}</p></div>
    </section>

    <section>
        <h2 class="bp-section-title">Domaines d'intervention</h2>
        <div class="mt-6 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
            {% for domain in domains %}
                <article class="bp-card p-6"><h3 class="font-semibold text-pasteur-dark">{{ domain.title|translate_content(app.request.locale) }}</h3><p class="mt-2 text-sm text-slate-600">{{ (domain.description ?? domain.summary ?? '')|translate_content(app.request.locale) }}</p></article>
            {% endfor %}
        </div>
    </section>

    <section>
        <h2 class="bp-section-title">Plan stratégique 2024 — 2028</h2>
        <p class="mt-4 leading-relaxed text-slate-600">{{ (settings.strategicPlan ?? '')|translate_content(app.request.locale) }}</p>
    </section>

    <section>
        <h2 class="bp-section-title">Documents institutionnels publics</h2>
        <ul class="bp-card mt-5 divide-y divide-slate-100 px-6">
            {% for document in documents %}
                <li class="flex items-center justify-between py-4 text-sm">
                    <span>{{ document.title|translate_content(app.request.locale) }}</span>
                    <a class="font-semibold text-pasteur-dark hover:underline" href="{{ document.path starts with '/' ? document.path : asset('uploads/' ~ document.path) }}" target="_blank" rel="noopener">{{ 'actions.download'|trans }}</a>
                </li>
            {% else %}
                <li class="py-5 text-sm text-slate-500">Aucun document public.</li>
            {% endfor %}
        </ul>
    </section>
</div>
{% endblock %}
