{% extends 'public/base.html.twig' %}

{% block title %}Qui sommes-nous ? — ASBL Bon Pasteur RDC{% endblock %}

{% block public_content %}
{% include 'public/_page_header.html.twig' with {
    eyebrow: 'Notre organisation',
    title: 'Qui sommes-nous ?',
    description: (settings.shortDescription ?? '')|translate_content(app.request.locale)
} %}

<section class="bp-container py-16 md:py-20">
    <div class="grid gap-10 lg:grid-cols-2">
        <div class="bp-card p-8 md:p-10">
            <p class="bp-eyebrow">Notre histoire</p>
            <p class="mt-5 leading-7 text-slate-600">{{ (settings.history ?? '')|translate_content(app.request.locale) }}</p>
        </div>
        <div class="bp-card p-8 md:p-10">
            <p class="bp-eyebrow">Objectifs institutionnels</p>
            <p class="mt-5 leading-7 text-slate-600">{{ (settings.objectives ?? '')|translate_content(app.request.locale) }}</p>
        </div>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-3">
        {% for label, value in {'Mission': settings.mission ?? '', 'Vision': settings.vision ?? '', 'Valeurs': settings.values ?? ''} %}
            <article class="bp-card-hover p-8">
                <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-pasteur-light text-sm font-bold text-pasteur-dark">{{ loop.index }}</span>
                <h2 class="mt-6 text-lg font-semibold text-pasteur-dark">{{ label }}</h2>
                <p class="mt-3 whitespace-pre-line text-sm leading-6 text-slate-600">{{ value|translate_content(app.request.locale) }}</p>
            </article>
        {% endfor %}
    </div>

    <div class="mt-16">
        <p class="bp-eyebrow">Domaines d'intervention</p>
        <h2 class="bp-section-title">Agir là où l'impact est réel</h2>
        <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
            {% for domain in domains %}
                <article class="bp-card-hover p-6">
                    <h3 class="font-semibold text-pasteur-dark">{{ domain.title|translate_content(app.request.locale) }}</h3>
                    <p class="mt-3 text-sm leading-6 text-slate-600">{{ (domain.description ?? domain.summary ?? '')|translate_content(app.request.locale) }}</p>
                </article>
            {% endfor %}
        </div>
    </div>

    <div class="bp-cta-dark mt-16 items-start !py-12 !text-left md:!px-12">
        <div class="relative z-10 max-w-3xl">
            <p class="bp-eyebrow text-amini-gold before:!bg-amini-gold">Plan stratégique</p>
            <h2 class="mt-6 text-4xl font-medium md:text-5xl">2024 — 2028</h2>
            <p class="mt-5 max-w-2xl leading-8 text-white/70">{{ (settings.strategicPlan ?? '')|translate_content(app.request.locale) }}</p>
        </div>
    </div>

    <div class="mt-16">
        <p class="bp-eyebrow">Transparence</p>
        <h2 class="bp-section-title">Documents institutionnels publics</h2>
        <div class="bp-card mt-6 divide-y divide-slate-100 px-6">
            {% for document in documents %}
                <div class="flex flex-wrap items-center justify-between gap-3 py-5">
                    <span class="font-medium text-slate-800">{{ document.title|translate_content(app.request.locale) }}</span>
                    <a class="bp-link-arrow" href="{{ document.path starts with '/' ? document.path : asset('uploads/' ~ document.path) }}" target="_blank" rel="noopener">{{ 'actions.download'|trans }} &rarr;</a>
                </div>
            {% else %}
                <p class="py-6 text-sm text-slate-500">Aucun document public.</p>
            {% endfor %}
        </div>
    </div>
</section>
{% endblock %}
