{% extends 'public/base.html.twig' %}

{% block title %}Contact — ASBL Bon Pasteur RDC{% endblock %}

{% block public_content %}
{% include 'public/_page_header.html.twig' with {
    eyebrow: 'Échangeons',
    title: 'Contact',
    description: 'Une question, une proposition de partenariat ou un besoin d’information ? Écrivez-nous.'
} %}

<section class="bp-container grid gap-10 py-16 md:py-20 lg:grid-cols-5">
    <div class="lg:col-span-2">
        <div class="bp-card p-8">
            <p class="bp-eyebrow">Nos coordonnées</p>
            <div class="mt-6 space-y-6 text-sm text-slate-600">
                <div class="flex gap-4">
                    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-pasteur-light text-pasteur-dark">
                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 21s7-5.4 7-11a7 7 0 10-14 0c0 5.6 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
                    </span>
                    <div><p class="text-xs font-bold uppercase tracking-wide text-slate-400">Adresse</p><p class="mt-1">{{ settings.address ?? 'Province du Lualaba, RDC' }}</p></div>
                </div>
                <div class="flex gap-4">
                    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-pasteur-light text-pasteur-dark">
                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 6h18v12H3z"/><path stroke-linecap="round" stroke-width="1.8" d="M3 7l9 6 9-6"/></svg>
                    </span>
                    <div><p class="text-xs font-bold uppercase tracking-wide text-slate-400">Email</p><p class="mt-1">{{ settings.email ?? 'contact@bonpasteur-rdc.org' }}</p></div>
                </div>
                <div class="flex gap-4">
                    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-pasteur-light text-pasteur-dark">
                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 4h4l2 5-2.5 1.5a12 12 0 005 5L15 13l5 2v4a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2z"/></svg>
                    </span>
                    <div><p class="text-xs font-bold uppercase tracking-wide text-slate-400">Téléphone</p><p class="mt-1">{{ settings.phone ?? '' }}{% if settings.phoneSecondary %} / {{ settings.phoneSecondary }}{% endif %}</p></div>
                </div>
            </div>
            {% if settings.gpsCoordinates %}<p class="mt-6 rounded-2xl bg-slate-50 p-4 text-xs text-slate-500">Localisation : {{ settings.gpsCoordinates }}</p>{% endif %}
            {% if settings.socialLinks|length %}
                <div class="mt-6 border-t border-slate-100 pt-6">
                    <p class="text-xs font-bold uppercase tracking-wide text-slate-400">Réseaux sociaux</p>
                    <div class="mt-3 flex flex-wrap gap-3">
                        {% for network, url in settings.socialLinks %}<a class="bp-link-arrow" href="{{ url }}" target="_blank" rel="noopener">{{ network|capitalize }} &rarr;</a>{% endfor %}
                    </div>
                </div>
            {% endif %}
        </div>
    </div>

    <div class="lg:col-span-3">
        <div class="bp-card p-8 md:p-10">
            <p class="bp-eyebrow">Envoyer un message</p>
            <h2 class="mt-2 text-2xl font-bold text-pasteur-dark">Parlons de votre projet</h2>
            {{ form_start(form, {'attr': {'class': 'mt-8 grid gap-5 sm:grid-cols-2'}}) }}
                {% for field in form %}
                    <div {% if field.vars.name != 'message' %}class="sm:col-span-1"{% else %}class="sm:col-span-2"{% endif %}>
                        {{ form_label(field, null, {'label_attr': {'class': 'bp-label'}}) }}
                        {{ form_widget(field, {'attr': {'class': 'bp-input'}}) }}
                        {{ form_errors(field) }}
                    </div>
                {% endfor %}
                <div class="sm:col-span-2"><button type="submit" class="bp-btn-primary">{{ 'contact.send'|trans }} &rarr;</button></div>
            {{ form_end(form) }}
        </div>
    </div>
</section>
{% endblock %}
