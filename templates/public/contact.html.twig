{% extends 'public/base.html.twig' %}

{% block title %}Contact — ASBL Bon Pasteur RDC{% endblock %}

{% block public_content %}
<div class="bg-pasteur-dark py-14 text-white">
    <div class="mx-auto max-w-7xl px-4">
        <h1 class="text-3xl font-bold md:text-4xl">{{ 'contact.title'|trans }}</h1>
        <p class="mt-3 max-w-3xl text-white/75">Une question, une proposition de partenariat ? Écrivez-nous.</p>
    </div>
</div>

<div class="mx-auto grid max-w-7xl gap-10 px-4 py-12 lg:grid-cols-2">
    <section>
        <h2 class="bp-section-title">Nos coordonnées</h2>
        <div class="bp-card mt-5 space-y-4 p-6 text-sm text-slate-600">
            <p><span class="block text-xs uppercase text-slate-400">Adresse</span>{{ settings.address ?? 'Province du Lualaba, RDC' }}</p>
            <p><span class="block text-xs uppercase text-slate-400">Email</span>{{ settings.email ?? 'contact@bonpasteur-rdc.org' }}</p>
            <p><span class="block text-xs uppercase text-slate-400">Téléphone</span>{{ settings.phone ?? '' }}{% if settings.phoneSecondary %} / {{ settings.phoneSecondary }}{% endif %}</p>
            {% if settings.gpsCoordinates %}<p><span class="block text-xs uppercase text-slate-400">Localisation</span>{{ settings.gpsCoordinates }}</p>{% endif %}
            {% if settings.socialLinks|length %}
                <div><span class="block text-xs uppercase text-slate-400">Réseaux sociaux</span>
                    <div class="mt-2 flex flex-wrap gap-3">
                        {% for network, url in settings.socialLinks %}<a class="text-pasteur-dark hover:underline" href="{{ url }}" target="_blank" rel="noopener">{{ network|capitalize }} &rarr;</a>{% endfor %}
                    </div>
                </div>
            {% endif %}
        </div>
    </section>

    <section>
        <h2 class="bp-section-title">Envoyer un message</h2>
        {{ form_start(form, {'attr': {'class': 'bp-card mt-5 space-y-4 p-6'}}) }}
            {% for field in form %}
                <div>
                    {{ form_label(field, null, {'label_attr': {'class': 'bp-label'}}) }}
                    {{ form_widget(field, {'attr': {'class': 'bp-input'}}) }}
                    {{ form_errors(field) }}
                </div>
            {% endfor %}
            <button type="submit" class="bp-btn-primary">{{ 'contact.send'|trans }}</button>
        {{ form_end(form) }}
    </section>
</div>
{% endblock %}
