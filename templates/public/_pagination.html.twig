{% if pagination.pages > 1 %}
<nav class="mt-12 flex flex-wrap items-center justify-center gap-2" aria-label="Pagination">
    {% if pagination.currentPage > 1 %}
        <a href="{{ path(paginationRoute, paginationParams|merge({page: pagination.currentPage - 1})) }}" class="bp-btn border border-slate-200 bg-white px-4 py-2 text-xs text-slate-600 hover:border-pasteur-green">&larr;</a>
    {% endif %}
    {% for page in 1..pagination.pages %}
        <a href="{{ path(paginationRoute, paginationParams|merge({page: page})) }}" class="bp-btn px-4 py-2 text-xs {{ page == pagination.currentPage ? 'bg-pasteur-dark text-white shadow-md' : 'border border-slate-200 bg-white text-slate-600 hover:border-pasteur-green' }}">{{ page }}</a>
    {% endfor %}
    {% if pagination.currentPage < pagination.pages %}
        <a href="{{ path(paginationRoute, paginationParams|merge({page: pagination.currentPage + 1})) }}" class="bp-btn border border-slate-200 bg-white px-4 py-2 text-xs text-slate-600 hover:border-pasteur-green">&rarr;</a>
    {% endif %}
</nav>
{% endif %}
