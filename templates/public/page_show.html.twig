{% extends 'public/base.html.twig' %}

{% block title %}{{ page.title|translate_content(app.request.locale) }} — ASBL Bon Pasteur RDC{% endblock %}
{% block meta_description %}{{ (page.metaDescription ?? page.title)|translate_content(app.request.locale) }}{% endblock %}

{% block public_content %}
{% include 'public/_page_header.html.twig' with {
    eyebrow: 'Page institutionnelle',
    title: page.title|translate_content(app.request.locale),
    description: page.metaDescription|translate_content(app.request.locale),
    back_route: 'app_pages',
    back_label: 'Pages'
} %}

<section class="bp-container py-16 md:py-20">
    <article class="bp-card mx-auto max-w-4xl p-8 md:p-12">
        <div class="bp-prose whitespace-pre-line">{{ (page.content ?? '')|translate_content(app.request.locale) }}</div>
    </article>
</section>
{% endblock %}
