{% extends 'public/base.html.twig' %}

{% block title %}Nos partenaires — ASBL Bon Pasteur RDC{% endblock %}

{% block public_content %}
{% include 'public/_page_header.html.twig' with {
    eyebrow: 'Réseau',
    title: 'Nos partenaires',
    description: 'Partenaires techniques, financiers et bailleurs de fonds qui accompagnent notre mission.'
} %}

<section class="bp-container py-16 md:py-20">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {% for partner in partners %}
            <article class="bp-card-hover p-7 text-center">
                <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-3xl bg-pasteur-light/60 p-3">
                    {% if partner.logoPath %}<img src="{{ partner.logoPath starts with '/' ? partner.logoPath : asset('uploads/' ~ partner.logoPath) }}" alt="{{ partner.name }}" class="h-full w-full object-contain" loading="lazy">{% else %}<span class="text-lg font-bold text-pasteur-dark">{{ partner.name|slice(0, 2)|upper }}</span>{% endif %}
                </div>
                <h2 class="mt-5 font-semibold text-pasteur-dark">{{ partner.name }}</h2>
                <p class="mt-1 text-xs font-semibold uppercase tracking-wide text-slate-400">{{ partner.type.label() }}</p>
                <p class="mt-3 text-sm leading-6 text-slate-600">{{ partner.description ?? '' }}</p>
                {% if partner.websiteUrl %}<a href="{{ partner.websiteUrl }}" class="bp-link-arrow mt-5" target="_blank" rel="noopener">Site web <span>&rarr;</span></a>{% endif %}
            </article>
        {% else %}
            <p class="text-sm text-slate-500">Aucun partenaire enregistré.</p>
        {% endfor %}
    </div>

    <div class="mt-16">
        <p class="bp-eyebrow">Prix et distinctions</p>
        <h2 class="bp-section-title">Reconnaissances</h2>
        <div class="mt-8 grid gap-5 md:grid-cols-2">
            {% for award in awards %}
                <article class="bp-card-hover flex gap-5 p-6">
                    <span class="bp-badge h-fit shrink-0 bg-pasteur-light text-pasteur-dark">{{ award.year }}</span>
                    <div>
                        <h3 class="font-semibold text-pasteur-dark">{{ award.title|translate_content(app.request.locale) }}</h3>
                        <p class="mt-2 text-sm text-slate-600">{{ award.issuer ?? '' }} {% if award.description %}— {{ award.description|translate_content(app.request.locale) }}{% endif %}</p>
                    </div>
                </article>
            {% endfor %}
        </div>
    </div>
</section>
{% endblock %}
