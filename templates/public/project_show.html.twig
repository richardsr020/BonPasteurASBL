{% extends 'public/base.html.twig' %}

{% block title %}{{ project.title|translate_content(app.request.locale) }} — ASBL Bon Pasteur RDC{% endblock %}

{% block public_content %}
{% include 'public/_page_header.html.twig' with {
    eyebrow: 'Projet',
    title: project.title|translate_content(app.request.locale),
    description: project.status.label() ~ ' · ' ~ (project.geographicZone ?? 'Lualaba'),
    back_route: 'app_projects',
    back_label: 'Nos projets'
} %}

<section class="bp-container py-16 md:py-20">
    {% if project.coverImage %}
        <div class="relative mb-12 h-72 overflow-hidden rounded-[2rem] bg-pasteur-light md:h-96">
            <img src="{{ project.coverImage starts with '/' ? project.coverImage : asset('uploads/' ~ project.coverImage) }}" alt="{{ project.title|translate_content(app.request.locale) }}" class="h-full w-full object-cover">
            <div class="absolute inset-0 bg-gradient-to-t from-pasteur-dark/60 to-transparent"></div>
        </div>
    {% endif %}

    <div class="grid gap-10 lg:grid-cols-3">
        <div class="bp-prose space-y-10 lg:col-span-2">
            <section><h2 class="!mt-0">Contexte</h2><p class="whitespace-pre-line">{{ (project.context ?? '')|translate_content(app.request.locale) }}</p></section>
            <section><h2>Objectifs</h2><p class="whitespace-pre-line">{{ (project.objectives ?? '')|translate_content(app.request.locale) }}</p></section>
            <section><h2>Principales activités</h2><p class="whitespace-pre-line">{{ (project.mainActivities ?? '')|translate_content(app.request.locale) }}</p></section>
            <section><h2>Résultats obtenus</h2><p class="whitespace-pre-line">{{ (project.resultsObtained ?? '')|translate_content(app.request.locale) }}</p></section>
        </div>

        <aside class="space-y-6">
            <div class="bp-card p-7">
                <p class="bp-eyebrow">Informations</p>
                <dl class="mt-5 space-y-5 text-sm text-slate-600">
                    <div><dt class="text-xs font-bold uppercase tracking-wide text-slate-400">Groupes cibles</dt><dd class="mt-1">{{ (project.targetGroups ?? '-')|translate_content(app.request.locale) }}</dd></div>
                    <div><dt class="text-xs font-bold uppercase tracking-wide text-slate-400">Période</dt><dd class="mt-1">{{ project.startDate ? project.startDate|date('m/Y') : '-' }} — {{ project.endDate ? project.endDate|date('m/Y') : 'en cours' }}</dd></div>
                    {% if project.showDonorPublicly and project.partners|length %}
                        <div><dt class="text-xs font-bold uppercase tracking-wide text-slate-400">Partenaires</dt><dd class="mt-1">{{ project.partners|map(p => p.name)|join(', ') }}</dd></div>
                    {% endif %}
                </dl>
            </div>
            {% if documents|length %}
                <div class="bp-card p-7">
                    <p class="bp-eyebrow">Documents publics</p>
                    <ul class="mt-5 space-y-3 text-sm">
                        {% for document in documents %}<li><a class="bp-link-arrow" href="{{ document.path starts with '/' ? document.path : asset('uploads/' ~ document.path) }}" target="_blank" rel="noopener">{{ document.title|translate_content(app.request.locale) }} &rarr;</a></li>{% endfor %}
                    </ul>
                </div>
            {% endif %}
        </aside>
    </div>

    {% if project.medias|length %}
        <section class="mt-16">
            <p class="bp-eyebrow">Galerie</p>
            <h2 class="bp-section-title">Photos et vidéos</h2>
            <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
                {% for media in project.medias %}
                    <figure class="bp-card-hover overflow-hidden">
                        {% if media.type == 'video' %}<video controls class="w-full" src="{{ media.path starts with '/' ? media.path : asset('uploads/' ~ media.path) }}"></video>
                        {% else %}<img src="{{ media.path starts with '/' ? media.path : asset('uploads/' ~ media.path) }}" alt="{{ media.title|translate_content(app.request.locale) }}" class="h-48 w-full object-cover" loading="lazy">{% endif %}
                        <figcaption class="p-4 text-sm text-slate-600">{{ media.title|translate_content(app.request.locale) }}</figcaption>
                    </figure>
                {% endfor %}
            </div>
        </section>
    {% endif %}

    {% if testimonials|length %}
        <section class="mt-16">
            <p class="bp-eyebrow">Témoignages</p>
            <h2 class="bp-section-title">Ils racontent le projet</h2>
            <div class="mt-8 grid gap-6 md:grid-cols-3">
                {% for testimonial in testimonials %}
                    <figure class="bp-card-hover p-7">
                        <blockquote class="text-sm italic leading-7 text-slate-600">« {{ testimonial.storyText|translate_content(app.request.locale) }} »</blockquote>
                        <figcaption class="mt-5 font-semibold text-pasteur-dark">{{ testimonial.beneficiaryName }}</figcaption>
                    </figure>
                {% endfor %}
            </div>
        </section>
    {% endif %}
</section>
{% endblock %}
