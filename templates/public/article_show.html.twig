{% extends 'public/base.html.twig' %}

{% block title %}{{ article.title|translate_content(app.request.locale) }} — ASBL Bon Pasteur RDC{% endblock %}

{% block public_content %}
{% include 'public/_page_header.html.twig' with {
    eyebrow: article.category.label(),
    title: article.title|translate_content(app.request.locale),
    description: article.publishedAt ? article.publishedAt|date('d/m/Y') : '',
    back_route: 'app_articles',
    back_label: 'Actualités'
} %}

<section class="bp-container py-16 md:py-20">
    <article class="bp-card mx-auto max-w-4xl overflow-hidden">
        {% if article.coverImage %}<img src="{{ article.coverImage starts with '/' ? article.coverImage : asset('uploads/' ~ article.coverImage) }}" alt="{{ article.title|translate_content(app.request.locale) }}" class="h-72 w-full object-cover md:h-96">{% endif %}
        <div class="p-8 md:p-12">
            <div class="bp-prose whitespace-pre-line">{{ (article.content ?? '')|translate_content(app.request.locale) }}</div>
            {% if article.attachmentPath %}
                <a class="bp-btn-outline mt-10" href="{{ article.attachmentPath starts with '/' ? article.attachmentPath : asset('uploads/' ~ article.attachmentPath) }}" target="_blank" rel="noopener">{{ 'actions.download'|trans }} — pièce jointe &rarr;</a>
            {% endif %}
        </div>
    </article>
</section>
{% endblock %}
