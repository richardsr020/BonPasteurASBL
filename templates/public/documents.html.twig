{% extends 'public/base.html.twig' %}

{% block title %}Documents publics — ASBL Bon Pasteur RDC{% endblock %}

{% block public_content %}
<div class="bg-pasteur-dark py-14 text-white">
    <div class="mx-auto max-w-7xl px-4">
        <h1 class="text-3xl font-bold md:text-4xl">Documents publics</h1>
        <p class="mt-3 max-w-3xl text-white/75">Rapports, publications et documents institutionnels accessibles au public.</p>
    </div>
</div>

<div class="mx-auto max-w-7xl px-4 py-12">
    <ul class="bp-card divide-y divide-slate-100 px-6">
        {% for document in documents %}
            <li class="flex flex-wrap items-center justify-between gap-3 py-4 text-sm">
                <div>
                    <p class="font-medium text-slate-800">{{ document.title }}</p>
                    {% if document.project %}<p class="text-xs text-slate-500">{{ document.project.title }}</p>{% endif %}
                </div>
                <a class="font-semibold text-pasteur-dark hover:underline" href="{{ document.path starts with '/' ? document.path : asset('uploads/' ~ document.path) }}" target="_blank" rel="noopener">{{ 'actions.download'|trans }} {% if document.extension %}({{ document.extension|upper }}){% endif %}</a>
            </li>
        {% else %}
            <li class="py-6 text-sm text-slate-500">Aucun document public.</li>
        {% endfor %}
    </ul>
</div>
{% endblock %}
