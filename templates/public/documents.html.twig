{% extends 'public/base.html.twig' %}

{% block title %}Documents publics — ASBL Bon Pasteur RDC{% endblock %}

{% block public_content %}
{% include 'public/_page_header.html.twig' with {
    eyebrow: 'Transparence',
    title: 'Documents publics',
    description: 'Rapports, publications et documents institutionnels accessibles au public.'
} %}

<section class="bp-container py-16 md:py-20">
    <div class="bp-card overflow-hidden">
        {% for document in documents %}
            <div class="flex flex-wrap items-center justify-between gap-4 border-b border-slate-100 px-6 py-5 last:border-0 hover:bg-slate-50/70">
                <div class="flex items-center gap-4">
                    <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-pasteur-light text-xs font-bold uppercase text-pasteur-dark">{{ document.extension ?? 'pdf' }}</span>
                    <div>
                        <p class="font-semibold text-slate-800">{{ document.title|translate_content(app.request.locale) }}</p>
                        {% if document.project %}<p class="mt-1 text-xs text-slate-500">{{ document.project.title|translate_content(app.request.locale) }}</p>{% endif %}
                    </div>
                </div>
                <a class="bp-btn-outline px-4 py-2 text-xs" href="{{ document.path starts with '/' ? document.path : asset('uploads/' ~ document.path) }}" target="_blank" rel="noopener">{{ 'actions.download'|trans }} {% if document.extension %}({{ document.extension|upper }}){% endif %}</a>
            </div>
        {% else %}
            <p class="px-6 py-10 text-center text-sm text-slate-500">Aucun document public.</p>
        {% endfor %}
    </div>
</section>
{% endblock %}
