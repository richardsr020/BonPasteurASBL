{% extends 'public/base.html.twig' %}

{% block title %}{{ 'nav.testimonials'|trans }} — ASBL Bon Pasteur RDC{% endblock %}

{% block public_content %}
<div class="bg-pasteur-dark py-14 text-white">
    <div class="mx-auto max-w-7xl px-4">
        <h1 class="text-3xl font-bold md:text-4xl">{{ 'nav.testimonials'|trans }}</h1>
        <p class="mt-3 max-w-3xl text-white/75">Les voix des bénéficiaires et des communautés accompagnées.</p>
    </div>
</div>
<div class="mx-auto max-w-7xl px-4 py-12">
    <div class="grid gap-6 md:grid-cols-3">
        {% for testimonial in testimonials %}
            <figure class="bp-card p-6">
                <blockquote class="text-sm italic leading-relaxed text-slate-600">« {{ testimonial.storyText|translate_content(app.request.locale) }} »</blockquote>
                <figcaption class="mt-4 font-semibold text-pasteur-dark">
                    {{ testimonial.beneficiaryName|translate_content(app.request.locale) }}
                    {% if testimonial.roleOrContext %}<span class="block font-normal text-xs text-slate-500">{{ testimonial.roleOrContext|translate_content(app.request.locale) }}</span>{% endif %}
                </figcaption>
            </figure>
        {% else %}
            <p class="text-sm text-slate-500">Aucun témoignage publié.</p>
        {% endfor %}
    </div>
    {{ include('public/_pagination.html.twig') }}
</div>
{% endblock %}
