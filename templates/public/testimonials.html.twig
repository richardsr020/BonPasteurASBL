{% extends 'public/base.html.twig' %}

{% block title %}{{ 'nav.testimonials'|trans }} — ASBL Bon Pasteur RDC{% endblock %}

{% block public_content %}
{% include 'public/_page_header.html.twig' with {
    eyebrow: 'Voix des communautés',
    title: 'Témoignages',
    description: 'Les voix des bénéficiaires et des communautés accompagnées par l’ASBL Bon Pasteur RDC.'
} %}

<section class="bp-container py-16 md:py-20">
    <div class="grid gap-7 md:grid-cols-2 lg:grid-cols-3">
        {% for testimonial in testimonials %}
            <figure class="bp-card-hover relative overflow-hidden p-8">
                <span class="absolute -right-2 -top-6 text-8xl font-bold text-pasteur-light/70">“</span>
                <blockquote class="relative text-sm italic leading-7 text-slate-600">{{ testimonial.storyText|translate_content(app.request.locale) }}</blockquote>
                <figcaption class="mt-6 border-t border-slate-100 pt-5">
                    <p class="font-semibold text-pasteur-dark">{{ testimonial.beneficiaryName|translate_content(app.request.locale) }}</p>
                    {% if testimonial.roleOrContext %}<p class="mt-1 text-xs text-slate-500">{{ testimonial.roleOrContext|translate_content(app.request.locale) }}</p>{% endif %}
                </figcaption>
            </figure>
        {% else %}
            <p class="text-sm text-slate-500">Aucun témoignage publié.</p>
        {% endfor %}
    </div>
    {{ include('public/_pagination.html.twig') }}
</section>
{% endblock %}
