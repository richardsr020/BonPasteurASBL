{% extends 'public/base.html.twig' %}

{% block title %}ASBL Bon Pasteur RDC — Agents de changement au Lualaba{% endblock %}
{% block meta_description %}{{ (settings.shortDescription ?? 'Association humanitaire au Lualaba : protection de l\'enfant, éducation et autonomisation des femmes.')|translate_content(app.request.locale) }}{% endblock %}

{% block public_content %}
<section class="relative bg-pasteur-dark text-white" data-controller="home-carousel">
    {% for slide in slides %}
        <div class="relative h-[420px] md:h-[560px]" data-home-carousel-target="slide">
            <img {% if loop.first %}src="{{ slide.imagePath starts with '/' ? slide.imagePath : asset('uploads/' ~ slide.imagePath) }}"{% else %}data-src="{{ slide.imagePath starts with '/' ? slide.imagePath : asset('uploads/' ~ slide.imagePath) }}" src="data:image/gif;base64,R0lGODlhAQABAAAAACw="{% endif %} alt="{{ slide.title }}" class="absolute inset-0 h-full w-full object-cover opacity-35" loading="{% if loop.first %}eager{% else %}lazy{% endif %}">
            <div class="relative mx-auto flex h-full max-w-7xl flex-col justify-center px-4">
                <p class="text-sm font-semibold uppercase tracking-[0.2em] text-pasteur-light">ASBL Bon Pasteur RDC</p>
                <h1 class="mt-3 max-w-3xl text-3xl font-bold leading-tight md:text-5xl">{{ slide.title }}</h1>
                {% if slide.subtitle %}<p class="mt-4 max-w-2xl text-base text-white/80 md:text-lg">{{ slide.subtitle }}</p>{% endif %}
                {% if slide.ctaUrl %}
                    <div class="mt-7">
                        <a href="{{ slide.ctaUrl }}" class="bp-btn bg-white text-pasteur-dark hover:bg-pasteur-light">{{ slide.ctaLabel ?: 'Découvrir' }}</a>
                    </div>
                {% endif %}
            </div>
        </div>
    {% else %}
        <div class="flex h-[420px] items-center bg-pasteur-dark md:h-[560px]">
            <div class="mx-auto max-w-7xl px-4">
                <h1 class="max-w-3xl text-3xl font-bold md:text-5xl">{{ settings.organizationName ?? 'ASBL Bon Pasteur RDC' }}</h1>
                <p class="mt-4 max-w-2xl text-white/80">{{ (settings.shortDescription ?? '')|translate_content(app.request.locale) }}</p>
            </div>
        </div>
    {% endfor %}
    {% if slides|length > 1 %}
        <div class="absolute inset-x-0 bottom-5 flex justify-center gap-2">
            {% for slide in slides %}
                <button type="button" class="h-2.5 w-2.5 rounded-full bg-white/60 hover:bg-white" data-action="home-carousel#goTo" data-index="{{ loop.index0 }}" aria-label="Diapositive {{ loop.index }}"></button>
            {% endfor %}
        </div>
    {% endif %}
</section>

<section class="mx-auto max-w-7xl px-4 py-14">
    <div class="grid gap-10 lg:grid-cols-2">
        <div>
            <p class="bp-eyebrow">{{ 'home.mission'|trans }}</p>
            <h2 class="bp-section-title">{{ settings.organizationName ?? 'ASBL Bon Pasteur RDC' }}</h2>
            <p class="mt-4 leading-relaxed text-slate-600">{{ (settings.shortDescription ?? '')|translate_content(app.request.locale) }}</p>
            <p class="mt-4 leading-relaxed text-slate-600">{{ (settings.mission ?? '')|translate_content(app.request.locale) }}</p>
            <a href="{{ path('app_about', {_locale: app.request.locale}) }}" class="bp-btn-outline mt-6 inline-block">{{ 'actions.read_more'|trans }}</a>
        </div>
        <div class="bp-card bg-white p-6">
            <p class="bp-eyebrow">{{ 'home.vision'|trans }}</p>
            <p class="mt-3 leading-relaxed text-slate-600">{{ (settings.vision ?? '')|translate_content(app.request.locale) }}</p>
            {% set figures = settings.keyFigures ?? [] %}
            {% if figures|length %}
                <div class="mt-6 grid grid-cols-2 gap-4 border-t border-slate-100 pt-6">
                    {% for figure in figures %}
                        <div>
                            <p class="text-2xl font-bold text-pasteur-dark">{{ figure.value ?? figure.number ?? '' }}</p>
                            <p class="text-xs text-slate-500">{{ figure.label ?? '' }}</p>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
</section>

<section class="bg-white py-14">
    <div class="mx-auto max-w-7xl px-4">
        <p class="bp-eyebrow">{{ 'home.domains'|trans }}</p>
        <h2 class="bp-section-title">{{ 'home.domains'|trans }}</h2>
        <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
            {% for domain in domains %}
                <article class="bp-card p-6">
                    <h3 class="font-semibold text-pasteur-dark">{{ domain.title|translate_content(app.request.locale) }}</h3>
                    <p class="mt-2 text-sm leading-relaxed text-slate-600">{{ (domain.summary ?? '')|translate_content(app.request.locale) }}</p>
                </article>
            {% else %}
                <p class="text-sm text-slate-500">Domaines bientôt disponibles.</p>
            {% endfor %}
        </div>
    </div>
</section>

<section class="mx-auto max-w-7xl px-4 py-14">
    <div class="flex items-end justify-between gap-4">
        <div>
            <p class="bp-eyebrow">{{ 'home.current_projects'|trans }}</p>
            <h2 class="bp-section-title">{{ 'home.current_projects'|trans }}</h2>
        </div>
        <a href="{{ path('app_projects', {_locale: app.request.locale}) }}" class="bp-btn-outline">{{ 'actions.view_all'|trans }}</a>
    </div>
    <div class="mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
        {% for project in projects %}
            <article class="bp-card overflow-hidden">
                {% if project.coverImage %}<img src="{{ project.coverImage starts with '/' ? project.coverImage : asset('uploads/' ~ project.coverImage) }}" alt="{{ project.title|translate_content(app.request.locale) }}" class="h-40 w-full object-cover" loading="lazy">{% endif %}
                <div class="p-5">
                    <span class="bp-badge bg-pasteur-light text-pasteur-dark">{{ project.status.label() }}</span>
                    <h3 class="mt-3 font-semibold text-slate-800">{{ project.title|translate_content(app.request.locale) }}</h3>
                    <p class="mt-2 line-clamp-3 text-sm text-slate-600">{{ (project.context ?? '')|translate_content(app.request.locale) }}</p>
                    <a href="{{ path('app_project_show', {_locale: app.request.locale, slug: project.slug}) }}" class="mt-4 inline-block text-sm font-semibold text-pasteur-dark hover:underline">{{ 'actions.read_more'|trans }} &rarr;</a>
                </div>
            </article>
        {% endfor %}
    </div>
</section>

<section class="bg-white py-14">
    <div class="mx-auto max-w-7xl px-4">
        <p class="bp-eyebrow">{{ 'home.latest_news'|trans }}</p>
        <h2 class="bp-section-title">{{ 'home.latest_news'|trans }}</h2>
        <div class="mt-8 grid gap-6 md:grid-cols-3">
            {% for article in articles %}
                <article class="bp-card p-6">
                    <span class="bp-badge bg-slate-100 text-slate-600">{{ article.category.label() }}</span>
                    <h3 class="mt-3 font-semibold text-slate-800">{{ article.title|translate_content(app.request.locale) }}</h3>
                    <p class="mt-1 text-xs text-slate-500">{{ article.publishedAt ? article.publishedAt|date('d/m/Y') : '' }}</p>
                    <p class="mt-3 line-clamp-3 text-sm text-slate-600">{{ (article.content|striptags)|translate_content(app.request.locale) }}</p>
                    <a href="{{ path('app_article_show', {_locale: app.request.locale, slug: article.slug}) }}" class="mt-4 inline-block text-sm font-semibold text-pasteur-dark hover:underline">{{ 'actions.read_more'|trans }} &rarr;</a>
                </article>
            {% else %}
                <p class="text-sm text-slate-500">Aucune actualité publiée.</p>
            {% endfor %}
        </div>
    </div>
</section>

<section class="mx-auto max-w-7xl px-4 py-14">
    <p class="bp-eyebrow">{{ 'home.testimonies'|trans }}</p>
    <h2 class="bp-section-title">{{ 'home.testimonies'|trans }}</h2>
    <div class="mt-8 grid gap-6 md:grid-cols-3">
        {% for testimonial in testimonials %}
            <figure class="bp-card p-6">
                <blockquote class="text-sm italic leading-relaxed text-slate-600">« {{ testimonial.storyText|translate_content(app.request.locale) }} »</blockquote>
                <figcaption class="mt-4 font-semibold text-pasteur-dark">{{ testimonial.beneficiaryName }}{% if testimonial.roleOrContext %} <span class="font-normal text-slate-500">— {{ testimonial.roleOrContext|translate_content(app.request.locale) }}</span>{% endif %}</figcaption>
            </figure>
        {% endfor %}
    </div>
</section>

<section class="bg-white py-14">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 md:grid-cols-2">
        <div>
            <p class="bp-eyebrow">{{ 'home.partners'|trans }}</p>
            <h2 class="bp-section-title">{{ 'home.partners'|trans }}</h2>
            <div class="mt-6 flex flex-wrap gap-6">
                {% for partner in partners %}
                    <div class="w-28 text-center">
                        {% if partner.logoPath %}<img src="{{ partner.logoPath starts with '/' ? partner.logoPath : asset('uploads/' ~ partner.logoPath) }}" alt="{{ partner.name|translate_content(app.request.locale) }}" class="mx-auto h-14 object-contain grayscale" loading="lazy">{% endif %}
                        <p class="mt-2 text-xs text-slate-600">{{ partner.name|translate_content(app.request.locale) }}</p>
                    </div>
                {% endfor %}
            </div>
        </div>
        <div>
            <p class="bp-eyebrow">{{ 'home.awards'|trans }}</p>
            <h2 class="bp-section-title">{{ 'home.awards'|trans }}</h2>
            <ul class="mt-6 space-y-3 text-sm text-slate-600">
                {% for award in awards %}<li><strong class="text-pasteur-dark">{{ award.year }}</strong> — {{ award.title|translate_content(app.request.locale) }}{% if award.issuer %} ({{ award.issuer|translate_content(app.request.locale) }}){% endif %}</li>{% endfor %}
            </ul>
        </div>
    </div>
</section>
{% endblock %}
