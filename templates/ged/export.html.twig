<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{{ title }}</title>
    <style>
        body { font-family: DejaVu Sans, sans-serif; font-size: 10px; color: #1e293b; }
        header { border-bottom: 3px solid #1B7A4B; padding-bottom: 12px; margin-bottom: 20px; }
        h1 { font-size: 18px; color: #0F4C30; margin: 0; }
        h2 { font-size: 12px; color: #1B7A4B; margin: 16px 0 6px; }
        table { width: 100%; border-collapse: collapse; margin-top: 6px; }
        th, td { border: 1px solid #cbd5e1; padding: 5px; text-align: left; vertical-align: top; }
        th { background: #e8f5ee; font-size: 9px; }
        .meta td:first-child { font-weight: bold; width: 30%; background: #f8fafc; }
        .folder { margin-left: 12px; }
        footer { margin-top: 24px; border-top: 1px solid #cbd5e1; padding-top: 8px; font-size: 8px; color: #64748b; }
    </style>
</head>
<body>
{% macro folderTree(folder, depth) %}
    <div class="folder" style="margin-left: {{ depth * 8 }}px;">
        <h2>{{ folder.name }}</h2>
        {% set documents = folder.documents|filter(doc => not doc.isTrashed()) %}
        {% if documents|length %}
            <table>
                <thead><tr><th>Document</th><th>Fichier original</th><th>Type</th><th>Taille</th><th>Version</th><th>Ajouté le</th><th>Auteur</th><th>SHA-256</th></tr></thead>
                <tbody>
                {% for doc in documents %}
                    <tr>
                        <td>{{ doc.title }}</td>
                        <td>{{ doc.originalFilename }}</td>
                        <td>{{ doc.fileExtension|upper }}</td>
                        <td>{{ doc.humanFileSize }}</td>
                        <td>v{{ doc.version }}</td>
                        <td>{{ doc.createdAt|date('d/m/Y H:i') }}</td>
                        <td>{{ doc.uploadedBy ?? '-' }}</td>
                        <td style="font-size:7px;">{{ doc.checksumSha256 }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% endif %}
        {% for child in folder.children|sort((a, b) => a.displayOrder <=> b.displayOrder) %}
            {{ _self.folderTree(child, depth + 1) }}
        {% endfor %}
    </div>
{% endmacro %}

<header>
    <h1>ASBL BON PASTEUR RDC — Lualaba</h1>
    <p>Bordereau d'archivage numérique · {{ title }}</p>
</header>

<table class="meta">
    {% for label, value in meta %}
        <tr><td>{{ label }}</td><td>{{ value }}</td></tr>
    {% endfor %}
    <tr><td>Date d'édition</td><td>{{ 'now'|date('d/m/Y H:i') }}</td></tr>
</table>

{% if folders is defined and folders|length %}
    <h2>Arborescence et documents</h2>
    {% for folder in folders|sort((a, b) => a.displayOrder <=> b.displayOrder) %}
        {{ _self.folderTree(folder, 0) }}
    {% endfor %}
{% endif %}

{% if projects is defined and projects|length %}
    <h2>Projets d'archives</h2>
    <table>
        <thead><tr><th>Code</th><th>Projet</th><th>Dossiers</th><th>Documents</th><th>Description</th></tr></thead>
        <tbody>
        {% for item in projects %}
            <tr>
                <td>{{ item.code }}</td>
                <td>{{ item.title }}</td>
                <td>{{ item.folders|length }}</td>
                <td>{{ item.folders.reduce((carry, folder) => carry + folder.documents|length, 0) }}</td>
                <td>{{ item.description }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endif %}

<footer>
    Document généré automatiquement par la plateforme GED de l'ASBL Bon Pasteur RDC.
    Les empreintes SHA-256 garantissent l'intégrité des fichiers archivés.
</footer>
</body>
</html>
