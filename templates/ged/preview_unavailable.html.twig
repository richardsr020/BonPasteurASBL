{% extends 'admin/base.html.twig' %}

{% block admin_title %}Aperçu indisponible{% endblock %}

{% block admin_content %}
<div class="max-w-xl bp-card p-8 text-center">
    <h2 class="text-lg font-semibold text-slate-800">Aperçu indisponible</h2>
    <p class="mt-3 text-sm text-slate-600">{{ reason }}</p>
    <p class="mt-2 text-sm text-slate-500">Vous pouvez télécharger le document « {{ document.originalFilename }} » pour le consulter.</p>
    <div class="mt-6 flex justify-center gap-3">
        <a href="{{ path('admin_ged_document_download', {id: document.id}) }}" class="bp-btn-primary">Télécharger</a>
        <a href="{{ path('admin_ged_folder', {id: document.folder.id}) }}" class="bp-btn-outline">Retour au dossier</a>
    </div>
</div>
{% endblock %}
