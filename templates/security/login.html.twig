{% extends 'base.html.twig' %}

{% block title %}Connexion — {{ parent() }}{% endblock %}

{% block body %}
<main class="grid min-h-screen lg:grid-cols-2">
    <section class="bp-cta-dark hidden items-start !rounded-none !px-14 !py-16 !text-left lg:flex">
        <div class="relative z-10">
            <span class="flex h-12 w-12 items-center justify-center bg-amini-gold text-base font-bold text-amini-ink">BP</span>
            <p class="bp-eyebrow mt-12 text-amini-gold before:!bg-amini-gold">ASBL Bon Pasteur RDC</p>
            <h1 class="mt-6 max-w-lg text-5xl font-medium leading-[1.05] md:text-6xl">Espace d'administration.</h1>
            <p class="mt-6 max-w-md text-base leading-8 text-white/70">Lualaba, République Démocratique du Congo.</p>
        </div>
    </section>

    <section class="flex items-center justify-center bg-white px-5 py-16 sm:px-10">
        <div class="w-full max-w-md">
            <div class="mb-10">
                <span class="flex h-12 w-12 items-center justify-center bg-amini-ink text-base font-bold text-amini-gold lg:hidden">BP</span>
                <p class="bp-eyebrow mt-6">Accès sécurisé</p>
                <h2 class="mt-4 text-3xl font-medium tracking-[-0.04em] text-amini-ink">Se connecter</h2>
                <p class="mt-3 text-sm text-amini-steel">ASBL Bon Pasteur RDC — Lualaba</p>
            </div>

            <form method="post" class="grid gap-6 rounded-card border border-amini-line bg-white p-8">
                {% if error %}
                    <div class="rounded-xl border border-amini-wine/20 bg-amini-wine/5 p-4 font-mono text-[12px] uppercase tracking-[0.06em] text-amini-wine" role="alert">
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                <div>
                    <label class="bp-label" for="email">Adresse e-mail</label>
                    <input class="bp-input" type="email" id="email" name="_username" value="{{ lastUsername }}" autocomplete="username" required autofocus>
                </div>

                <div>
                    <label class="bp-label" for="password">Mot de passe</label>
                    <input class="bp-input" type="password" id="password" name="_password" autocomplete="current-password" required>
                </div>

                <label class="flex items-center gap-2 text-sm text-amini-muted">
                    <input type="checkbox" name="_remember_me" checked>
                    Rester connecté
                </label>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button class="bp-btn-primary w-full" type="submit">Se connecter</button>
            </form>

            <p class="mt-6 text-center font-mono text-[11px] uppercase tracking-[0.06em] text-amini-steel">Accès réservé au personnel autorisé de l'ASBL.</p>
        </div>
    </section>
</main>
{% endblock %}
